{
  "uid": "local-model-usage",
  "title": "Local model usage",
  "description": "Token usage on the local model through LiteLLM, per client and model. Generated by dev-environment grafana/local_model_usage.py; edits in the UI are overwritten by the next push.",
  "tags": [
    "lab",
    "dev-environment",
    "local-ai"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "regex": ".*-prom$",
        "current": {},
        "hide": 0
      },
      {
        "name": "client",
        "label": "Client",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(litellm_proxy_total_requests_metric_total, api_key_alias)",
          "refId": "client"
        },
        "definition": "label_values(litellm_proxy_total_requests_metric_total, api_key_alias)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "price_in",
        "label": "$/M input",
        "type": "textbox",
        "query": "3",
        "current": {
          "text": "3",
          "value": "3"
        },
        "hide": 0
      },
      {
        "name": "price_cached",
        "label": "$/M cached input",
        "type": "textbox",
        "query": "0.3",
        "current": {
          "text": "0.3",
          "value": "0.3"
        },
        "hide": 0
      },
      {
        "name": "price_out",
        "label": "$/M output",
        "type": "textbox",
        "query": "15",
        "current": {
          "text": "15",
          "value": "15"
        },
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Lab overview",
      "type": "dashboards",
      "tags": [],
      "url": "/d/lab-overview",
      "targetBlank": false,
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "icon": "dashboard"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "At a glance",
      "id": 2,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Last 5 hours",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum (increase(litellm_input_tokens_metric_total{api_key_alias=~\"$client\"}[$__range]) + (min_over_time(litellm_input_tokens_metric_total{api_key_alias=~\"$client\"}[$__range]) unless litellm_input_tokens_metric_total{api_key_alias=~\"$client\"} offset $__range) or increase(litellm_input_tokens_metric_total{api_key_alias=~\"$client\"}[$__range])) or vector(0))",
          "legendFormat": "Input",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum (increase(litellm_output_tokens_metric_total{api_key_alias=~\"$client\"}[$__range]) + (min_over_time(litellm_output_tokens_metric_total{api_key_alias=~\"$client\"}[$__range]) unless litellm_output_tokens_metric_total{api_key_alias=~\"$client\"} offset $__range) or increase(litellm_output_tokens_metric_total{api_key_alias=~\"$client\"}[$__range])) or vector(0))",
          "legendFormat": "Output",
          "refId": "B",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum (increase(litellm_proxy_total_requests_metric_total{api_key_alias=~\"$client\"}[$__range]) + (min_over_time(litellm_proxy_total_requests_metric_total{api_key_alias=~\"$client\"}[$__range]) unless litellm_proxy_total_requests_metric_total{api_key_alias=~\"$client\"} offset $__range) or increase(litellm_proxy_total_requests_metric_total{api_key_alias=~\"$client\"}[$__range])) or vector(0))",
          "legendFormat": "Requests",
          "refId": "C",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical"
      },
      "description": "Tokens and requests in the last 5 hours, the length of a Claude usage window.",
      "timeFrom": "5h",
      "hideTimeOverride": false
    },
    {
      "type": "stat",
      "title": "Today",
      "id": 4,
