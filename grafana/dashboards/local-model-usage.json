          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical"
      },
      "description": "The rolling week.",
      "timeFrom": "7d",
      "hideTimeOverride": false
    },
    {
      "type": "stat",
      "title": "Cloud-equivalent, last 7 days",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "((sum (increase(litellm_input_tokens_metric_total{api_key_alias=~\"$client\"}[$__range]) + (min_over_time(litellm_input_tokens_metric_total{api_key_alias=~\"$client\"}[$__range]) unless litellm_input_tokens_metric_total{api_key_alias=~\"$client\"} offset $__range) or increase(litellm_input_tokens_metric_total{api_key_alias=~\"$client\"}[$__range])) or vector(0)) - (sum (increase(litellm_input_cached_tokens_metric_total{api_key_alias=~\"$client\"}[$__range]) + (min_over_time(litellm_input_cached_tokens_metric_total{api_key_alias=~\"$client\"}[$__range]) unless litellm_input_cached_tokens_metric_total{api_key_alias=~\"$client\"} offset $__range) or increase(litellm_input_cached_tokens_metric_total{api_key_alias=~\"$client\"}[$__range])) or vector(0))) * $price_in / 1e6 + (sum (increase(litellm_input_cached_tokens_metric_total{api_key_alias=~\"$client\"}[$__range]) + (min_over_time(litellm_input_cached_tokens_metric_total{api_key_alias=~\"$client\"}[$__range]) unless litellm_input_cached_tokens_metric_total{api_key_alias=~\"$client\"} offset $__range) or increase(litellm_input_cached_tokens_metric_total{api_key_alias=~\"$client\"}[$__range])) or vector(0)) * $price_cached / 1e6 + (sum (increase(litellm_output_tokens_metric_total{api_key_alias=~\"$client\"}[$__range]) + (min_over_time(litellm_output_tokens_metric_total{api_key_alias=~\"$client\"}[$__range]) unless litellm_output_tokens_metric_total{api_key_alias=~\"$client\"} offset $__range) or increase(litellm_output_tokens_metric_total{api_key_alias=~\"$client\"}[$__range])) or vector(0)) * $price_out / 1e6",
          "legendFormat": "At your comparison prices",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
