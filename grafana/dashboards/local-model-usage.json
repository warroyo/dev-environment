          },
          "expr": "(sum (increase(litellm_input_tokens_metric_total{api_key_alias=~\"$client\"}[$__range]) + (min_over_time(litellm_input_tokens_metric_total{api_key_alias=~\"$client\"}[$__range]) unless litellm_input_tokens_metric_total{api_key_alias=~\"$client\"} offset $__range) or increase(litellm_input_tokens_metric_total{api_key_alias=~\"$client\"}[$__range])) or vector(0))",
          "legendFormat": "Input",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum (increase(litellm_output_tokens_metric_total{api_key_alias=~\"$client\"}[$__range]) + (min_over_time(litellm_output_tokens_metric_total{api_key_alias=~\"$client\"}[$__range]) unless litellm_output_tokens_metric_total{api_key_alias=~\"$client\"} offset $__range) or increase(litellm_output_tokens_metric_total{api_key_alias=~\"$client\"}[$__range])) or vector(0))",
          "legendFormat": "Output",
          "refId": "B",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum (increase(litellm_proxy_total_requests_metric_total{api_key_alias=~\"$client\"}[$__range]) + (min_over_time(litellm_proxy_total_requests_metric_total{api_key_alias=~\"$client\"}[$__range]) unless litellm_proxy_total_requests_metric_total{api_key_alias=~\"$client\"} offset $__range) or increase(litellm_proxy_total_requests_metric_total{api_key_alias=~\"$client\"}[$__range])) or vector(0))",
          "legendFormat": "Requests",
          "refId": "C",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical"
      },
      "description": "Since midnight, browser time.",
      "timeFrom": "now/d",
      "hideTimeOverride": false
    },
    {
      "type": "stat",
      "title": "Last 7 days",
      "id": 5,
