        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical"
      },
      "description": "What this week's local tokens would cost at the per-million prices in the dashboard variables (input, cached input, output). Set them to the API model you would otherwise use. The electricity is not counted.",
      "timeFrom": "7d",
      "hideTimeOverride": false
    },
    {
      "type": "row",
      "title": "Tokens",
      "id": 7,
      "collapsed": false,
