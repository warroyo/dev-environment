        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Tokens per day, by client",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "interval": "1d",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (api_key_alias) (increase(litellm_input_tokens_metric_total{api_key_alias=~\"$client\"}[$__interval]) + (min_over_time(litellm_input_tokens_metric_total{api_key_alias=~\"$client\"}[$__interval]) unless litellm_input_tokens_metric_total{api_key_alias=~\"$client\"} offset $__interval) or increase(litellm_input_tokens_metric_total{api_key_alias=~\"$client\"}[$__interval])) + sum by (api_key_alias) (increase(litellm_output_tokens_metric_total{api_key_alias=~\"$client\"}[$__interval]) + (min_over_time(litellm_output_tokens_metric_total{api_key_alias=~\"$client\"}[$__interval]) unless litellm_output_tokens_metric_total{api_key_alias=~\"$client\"} offset $__interval) or increase(litellm_output_tokens_metric_total{api_key_alias=~\"$client\"}[$__interval]))",
          "legendFormat": "{{api_key_alias}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "barAlignment": -1,
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "hermes-lab"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "hermes-restricted"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "scripts"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
