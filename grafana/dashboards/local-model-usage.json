        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Input plus output tokens per day, stacked by LiteLLM key. Days are UTC."
    },
