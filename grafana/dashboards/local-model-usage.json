        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum (increase(litellm_input_tokens_metric_total{api_key_alias=~\"$client\"}[$__range]) + (min_over_time(litellm_input_tokens_metric_total{api_key_alias=~\"$client\"}[$__range]) unless litellm_input_tokens_metric_total{api_key_alias=~\"$client\"} offset $__range) or increase(litellm_input_tokens_metric_total{api_key_alias=~\"$client\"}[$__range])) or vector(0))",
