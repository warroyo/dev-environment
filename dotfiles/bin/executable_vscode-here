#!/usr/bin/env bash
# Print a clickable OSC8 hyperlink that opens the current directory, on the
# current host, in VS Code Remote-SSH. General-purpose (works from a tmux
# pane on any SSH target, not just the Claude Code server) — applies on
# every machine, including the work MacBook Pro.
set -euo pipefail

host="$(hostname -f 2>/dev/null || hostname)"
cwd="$(pwd)"
uri="vscode://vscode-remote/ssh-remote+${host}${cwd}"

printf '\e]8;;%s\e\\Open in VS Code (%s on %s)\e]8;;\e\\\n' "$uri" "$cwd" "$host"
