{{- if eq .chezmoi.os "darwin" -}}
[credential]
    helper = osxkeychain
{{- else -}}
[credential]
    helper = cache --timeout=3600

# Per-machine local signing key, so signing never depends on a forwarded
# ssh-agent (which dies when the client disconnects, breaking unattended
# commits in tmux). Generated by provision/server-bootstrap.sh; register it
# on GitHub as a SIGNING key (not an auth key):
#
#   gh ssh-key add ~/.ssh/id_ed25519_signing.pub --type signing \
#     --title "$(hostname) git signing"
#
# Signing is NOT enabled by default — the key has to be registered first or
# every commit fails verification. Turn it on per machine once registered:
#
#   git config --file ~/.gitconfig.local commit.gpgsign true
[user]
    signingkey = ~/.ssh/id_ed25519_signing.pub

[gpg]
    format = ssh

# Sign through a wrapper that strips SSH_AUTH_SOCK. `ssh-keygen -Y sign` probes
# the agent before falling back to the on-disk key, so a forwarded socket left
# hanging by a closed laptop lid wedges `git commit` indefinitely with no
# error. Resolved off PATH (~/.local/bin) — git does NOT expand `~` in this
# value, so a bare name is both correct and portable.
[gpg "ssh"]
    program = git-ssh-sign
{{- end }}
