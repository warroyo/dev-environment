# TIER 1 — sourced by EVERY zsh: interactive shells, scripts, `zsh -c`, cron,
# and `ssh host <command>`. Keep it minimal, fast, and silent: no output, no
# prompts, nothing that touches a tty.
#
# This tier exists specifically so that
#     ssh claude-server 'claude --version'
# works. Non-interactive shells never read ~/.zshrc, so PATH set only there is
# invisible to remote commands, systemd units, and scripts.

# Deduplicate PATH automatically. Without this, re-sourcing (or a login shell
# that reads both .zshenv and .zshrc) silently grows PATH with duplicates.
typeset -U path PATH

# Helper scripts installed by chezmoi from dotfiles/dot_local/bin/, plus
# anything pip/pipx/uv --user drops there.
[[ -d "$HOME/.local/bin" ]] && path=("$HOME/.local/bin" $path)

# npm's global install prefix (set to this by server-bootstrap.sh, since the
# default is root-owned). Covers `npm install -g` binaries; npx itself comes
# from the system-wide Node.js package and needs no PATH entry of its own.
[[ -d "$HOME/.npm-global/bin" ]] && path=("$HOME/.npm-global/bin" $path)

export PATH

# Editor belongs in this tier: git, cron jobs and remote commands all need it,
# and none of them read .zshrc.
export EDITOR=vim
export VISUAL="$EDITOR"

# Blog writing flow: where /post-brief stages an approved, public-safe brief.
#
# Tier 1 for the same reason PATH is. `claude` is started by herdr under
# systemd (claude-open, and every session the Telegram bot opens), so it never
# reads .zshrc — a fragment in ~/.config/shell/source/ would be set in a
# terminal and unset in exactly the phone-driven sessions this flow is for.
#
# The variable exists so the PUBLIC warroyo-blog repo's /post-scaffold and
# /post-ship can find the brief without hard-coding a path to the private
# second-brain repo. Guarded on the directory rather than role-gated in
# .chezmoiignore.tmpl: ~/second-brain is cloned on the server, where Claude Code
# runs, and on both Macs, where Obsidian opens it as a vault
# (provision/lib/repos.sh). On the Macs the variable is set and unused — the
# commands that read it are server-only. Where the clone is missing it is
# simply never set, which is the case those commands already handle by asking
# for the brief instead.
[[ -d "$HOME/second-brain" ]] && export DEV_LOG_PITCHES="$HOME/second-brain/pitches"
