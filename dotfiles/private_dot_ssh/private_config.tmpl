{{- $claudeAllowed := or (eq .role "server") (eq .role "personal") -}}
# Machine-specific SSH config that must not be committed — usernames, one-off
# hosts, jump boxes. ssh uses FIRST-obtained value for each keyword, so this
# Include must come first for local settings to win. Missing file is ignored.
#
# The server's login name lives here rather than in the repo:
#     Host claude-server
#       User your-login-name
Include ~/.ssh/config.local

# ============================================================================
# General SSH defaults — applies on every machine
# ============================================================================
Host *
  AddKeysToAgent yes
  ServerAliveInterval 60
  ServerAliveCountMax 3
  Compression yes

{{ if $claudeAllowed -}}
# ----------------------------------------------------------------------------
# Claude Code server — reached over Tailscale.
#
# Skipped on the work laptop (and any machine with an unrecognised role): that
# machine reaches the server over the split-tunnel OpenVPN-to-LAN connection
# instead and never joins the tailnet, so it uses the server's LAN IP directly
# rather than this Host block. See docs/client-work-setup.md.
# ----------------------------------------------------------------------------
Host claude-server
  HostName {{ .serverHost }}
  ForwardAgent yes
{{ end -}}
# Machine-specific hosts belong in ~/.ssh/config.local (not managed by chezmoi,
# never committed) — include it from here if you need one.
