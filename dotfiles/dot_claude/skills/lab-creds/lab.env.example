# Template for ~/.lab.env. Copy it there, chmod 600, and fill in the secrets.
# Lab credentials for agents and scripts. The real file is never in git.
# Read it with: set -a; . ~/.lab.env; set +a
# Refresh the kubectl sessions with: ~/.claude/skills/lab-creds/refresh.sh
#
# Sources, when a value here stops working:
#   VC_*           ~/workspace/ansible-supervisor-service/.env
#   VCFA_PASSWORD  ~/workspace/goad/the-goad/terraform/cloud-admin/terraform.tfvars
#   VCFA_TENANT_API_TOKEN  TF_VAR_vcfa_refresh_token in ~/workspace/argocd-scaffolding/.env

# --- vCenter. The same login works for the Supervisor and most of the lab.
VC_HOST=vc01.gpu.set.lab
VC_USER=administrator@gpu.local
VC_PASSWORD=

# --- Supervisor. The vcf CLI context and its endpoint.
SUPERVISOR_CONTEXT=sup-gpu
SUPERVISOR_ENDPOINT=10.47.7.8

# --- VCF Automation. The provider administrator, in the System org.
VCFA_URL=https://auto.gpu.set.lab
VCFA_USER=admin
VCFA_ORG=System
VCFA_PASSWORD=

# --- VCF Automation, tenant org. The API token the vcf CLI contexts vcfa and
# vcfa:* log in with. It is a refresh token: it buys short-lived access tokens.
VCFA_CONTEXT=vcfa
VCFA_TENANT_ORG=acme
VCFA_TENANT_API_TOKEN=

# --- Tanzu Platform (Cloud Foundry) for GOAD, foundation "goad". Account
# goad-deployer, a Hub OAuth app. The foundation only takes its client
# assertion secret (private key), kept in the file below, mode 600.
# Token: CF_ACCESS_TOKEN=$(~/.claude/skills/lab-creds/cf-token.py)
TANZU_HUB_URL=https://hub.goad.gpu.set.lab
CF_API_URL=https://api.sys.goad.gpu.set.lab
CF_UAA_TOKEN_URL=https://uaa.sys.goad.gpu.set.lab/oauth/token
CF_CLIENT_ASSERTION_FILE=~/.lab/goad-deployer-client-assertion
