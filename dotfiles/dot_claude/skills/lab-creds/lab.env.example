# Template for ~/.lab.env. Copy it there, chmod 600, and fill in the secrets.
# Lab credentials for agents and scripts. The real file is never in git.
# Read it with: set -a; . ~/.lab.env; set +a
# Refresh the kubectl sessions with: ~/.claude/skills/lab-creds/refresh.sh
#
# Sources, when a value here stops working: list, per variable, the local file
# the value was copied from. Paths stay in the real file, not in this example.
#   VC_*           <path to the repo .env that holds the vCenter login>
#   VCFA_PASSWORD  <path to the terraform.tfvars that holds it>

# --- vCenter. The same login works for the Supervisor and most of the lab.
VC_HOST=vc.corp.example
VC_USER=administrator@vsphere.local
VC_PASSWORD=

# --- Supervisor. The vcf CLI context and its endpoint.
SUPERVISOR_CONTEXT=sup
SUPERVISOR_ENDPOINT=10.20.7.8

# --- VCF Automation. The provider administrator, in the System org.
VCFA_URL=https://vcfa.corp.example
VCFA_USER=admin
VCFA_ORG=System
VCFA_PASSWORD=

# --- VCF Automation, tenant org. The API token the vcf CLI contexts vcfa and
# vcfa:* log in with. It is a refresh token: it buys short-lived access tokens.
VCFA_CONTEXT=vcfa
VCFA_TENANT_ORG=tenant1
VCFA_TENANT_API_TOKEN=

# --- Tanzu Platform (Cloud Foundry). The deployer account is a Hub OAuth
# app. The foundation only takes its client
# assertion secret (private key), kept in the file below, mode 600.
# Token: CF_ACCESS_TOKEN=$(~/.claude/skills/lab-creds/cf-token.py)
TANZU_HUB_URL=https://hub.cf.corp.example
CF_API_URL=https://api.sys.cf.corp.example
CF_UAA_TOKEN_URL=https://uaa.sys.cf.corp.example/oauth/token
CF_CLIENT_ASSERTION_FILE=~/.lab/cf-deployer-client-assertion
