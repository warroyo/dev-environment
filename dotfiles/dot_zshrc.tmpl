{{/*
  Machine identity, from the shared hostname data in .chezmoidata.yaml.
  Both sides are normalized (lowercased, .local stripped) because
  .chezmoi.hostname excludes the domain and macOS reports mixed case —
  a raw `eq` comparison silently fails to match on the Macs.
*/}}
{{- $h := .chezmoi.hostname | lower | trimSuffix ".local" }}
{{- $isWorkLaptop := eq $h (.hostnames.workLaptop | lower | trimSuffix ".local") }}
{{- $isServer := eq $h (.hostnames.server | lower | trimSuffix ".local") }}

# ============================================================================
# General layer — applies on every machine (including the work MacBook Pro)
# ============================================================================

export EDITOR=vim
export VISUAL="$EDITOR"

# ~/.local/bin is where chezmoi installs this repo's helper scripts
# from dotfiles/dot_local/bin/ (which scripts land here varies by machine —
# see .chezmoiignore.tmpl).
export PATH="$HOME/.local/bin:$PATH"

# ---- History ----
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY          # history shared live across concurrent shells
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE      # a leading space keeps a command out of history
setopt HIST_REDUCE_BLANKS
setopt EXTENDED_HISTORY       # record timestamps

# ---- Completion ----
autoload -Uz compinit && compinit -u
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'   # case-insensitive

# ---- Modern CLI tools ----
# See docs/terminal-and-editor-defaults.md for why each is here.
# NOTE: deliberately NOT aliasing `find`/`grep` to fd/rg — their flag syntax
# is incompatible (`find . -name x`, `grep -r`), so aliasing them breaks
# muscle memory and copy-pasted commands in confusing ways. Use `fd`/`rg`
# by name.
alias ls='eza --group-directories-first'
alias ll='eza -la --group-directories-first'
alias lt='eza --tree --level=2'
alias cat='bat --paging=never'

alias gs='git status -sb'
alias gd='git diff'
alias gl='git log --graph --oneline --decorate'

alias reload='exec zsh'
alias vhere='vscode-here'

# ---- fzf shell integration ----
# Path differs by platform: Homebrew on macOS, /usr/share/doc on Debian/Ubuntu.
if [ -f ~/.fzf.zsh ]; then
  source ~/.fzf.zsh
elif command -v brew >/dev/null 2>&1 && [ -d "$(brew --prefix 2>/dev/null)/opt/fzf/shell" ]; then
  source "$(brew --prefix)/opt/fzf/shell/completion.zsh"
  source "$(brew --prefix)/opt/fzf/shell/key-bindings.zsh"
elif [ -d /usr/share/doc/fzf/examples ]; then
  [ -f /usr/share/doc/fzf/examples/completion.zsh ] && source /usr/share/doc/fzf/examples/completion.zsh
  [ -f /usr/share/doc/fzf/examples/key-bindings.zsh ] && source /usr/share/doc/fzf/examples/key-bindings.zsh
fi

{{- if $isWorkLaptop }}

# ----------------------------------------------------------------------------
# Work MacBook Pro only
# ----------------------------------------------------------------------------
# Belt-and-braces with the `claude-code.autoInstallIdeExtension: false`
# setting in the managed VS Code settings.json: this machine must never
# auto-install the Claude Code IDE extension when a VS Code integrated
# terminal opens. See docs/client-work-setup.md.
export CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL=1
{{- end }}

{{- if $isServer }}

# ----------------------------------------------------------------------------
# Server-only, general layer (not Claude-specific — just only meaningful on
# a machine that's actually SSH'd/tmux'd into, i.e. the server)
# ----------------------------------------------------------------------------

# A CLI tool that wants to open a URL (docs links, `gh auth login`, OAuth
# flows) can't launch a browser on a headless box. Ghostty renders
# http(s):// URLs as clickable links, so printing the URL and letting the
# human click it opens *their own* local browser on the Mac — no reverse
# tunnel, no listener, no token. Only takes effect inside an SSH/tmux
# session; doesn't affect actual listening dev servers, which VS Code
# Remote-SSH's port forwarding already handles.
if [ -n "$SSH_CONNECTION" ] || [ -n "$TMUX" ]; then
  export BROWSER=echo
  open() { echo "$1"; }
  alias xdg-open=open
fi

# Forwarded-agent-socket fix: a forwarded agent socket left over from a
# dropped connection still accepts connections but never answers, so a
# plain `ssh-add -l` after a sleep/network-roam can hang forever. Repoint a
# stable symlink at the freshest live socket on every login, and give any
# script that probes the agent a hard timeout instead of a hang. Only
# matters if you `ssh -A` into this box rather than using a key that lives
# on the server itself.
if [ -n "${SSH_AUTH_SOCK:-}" ] && [ -S "$SSH_AUTH_SOCK" ] && [ "$SSH_AUTH_SOCK" != "$HOME/.ssh/agent-socket" ]; then
  ln -sf "$SSH_AUTH_SOCK" "$HOME/.ssh/agent-socket"
fi
if [ -S "$HOME/.ssh/agent-socket" ]; then
  export SSH_AUTH_SOCK="$HOME/.ssh/agent-socket"
fi
alias ssh-check='timeout 2 ssh-add -l'
{{- end }}

{{- if not $isWorkLaptop }}

# ============================================================================
# Claude Code layer — everywhere except the work MacBook Pro
# ============================================================================

alias ca='claude-attach'
alias ce='claude-env'

{{- if $isServer }}
# Claude Code deliberately downgrades color output whenever $TMUX is set, as
# a conservative default for unknown terminals. Ghostty is the standardized
# terminal for this whole setup and is known-good for true color, so it's
# safe to opt back in.
export CLAUDE_CODE_TMUX_TRUECOLOR=1
{{- end }}
{{- end }}
