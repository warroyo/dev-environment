#!/usr/bin/env bash
# Shared writer for the dev session log (server only). The /log-session
# command funnels through this one script, so there is exactly one place that
# knows the file naming, the append-with-separator rule, and the commit/push
# step. See ~/dev-log/README.md.
#
# Usage: dev-log-entry [-p project-slug] [-s session-id] <<'EOF'
#   ## Decision
#   ...
# EOF
#
# The entry body is read from stdin verbatim (already-formatted markdown —
# this script does no templating of its own) and written to
# ~/dev-log/entries/YYYY-MM-DD-<project-slug>-<session>.md, creating the file
# or appending with a `---` separator as needed. Prints the path it wrote to.
#
# The session component keeps entries from *different* Claude Code sessions in
# separate files even on the same day for the same project, while repeated
# /log-session calls within one session keep appending to that session's file.
# It comes from -s, else $CLAUDE_CODE_SESSION_ID (set by Claude Code in every
# session's environment); with neither, the file falls back to the old
# date+project name.
set -euo pipefail

DEV_LOG_DIR="${DEV_LOG_DIR:-$HOME/dev-log}"
ENTRIES_DIR="$DEV_LOG_DIR/entries"

project_slug=""
session_id="${CLAUDE_CODE_SESSION_ID:-}"
while getopts "p:s:" opt; do
  case "$opt" in
    p) project_slug="$OPTARG" ;;
    s) session_id="$OPTARG" ;;
    *)
      printf 'usage: %s [-p project-slug] [-s session-id] < entry.md\n' "${0##*/}" >&2
      exit 2
      ;;
  esac
done

if [ -z "$project_slug" ]; then
  # No slug given: derive one from the current git repo's name, falling back
  # to the current directory name outside a repo.
  root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  project_slug="$(basename "$root" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | sed -E 's/-+/-/g; s/^-|-$//g')"
fi

if [ -z "$project_slug" ]; then
  echo "dev-log-entry: could not determine a project slug" >&2
  exit 1
fi

body="$(cat)"
# Nothing to write is not an error — a caller may legitimately decide there's
# nothing worth logging.
if [ -z "${body//[[:space:]]/}" ]; then
  echo "dev-log-entry: empty entry body, nothing written" >&2
  exit 0
fi

# A short prefix of the session UUID is enough to keep same-day sessions apart
# and keeps the filename readable.
session_suffix=""
if [ -n "$session_id" ]; then
  clean_session="$(printf '%s' "$session_id" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | sed -E 's/-+/-/g; s/^-|-$//g')"
  [ -n "$clean_session" ] && session_suffix="-${clean_session:0:8}"
fi

mkdir -p "$ENTRIES_DIR"
target="$ENTRIES_DIR/$(date +%F)-${project_slug}${session_suffix}.md"

if [ -s "$target" ]; then
  { printf '\n---\n\n'; printf '%s\n' "$body"; } >> "$target"
else
  printf '%s\n' "$body" >> "$target"
fi

if git -C "$DEV_LOG_DIR" rev-parse --git-dir >/dev/null 2>&1; then
  git -C "$DEV_LOG_DIR" add -- "$target" >/dev/null 2>&1 || true
  git -C "$DEV_LOG_DIR" commit -q -m "log: ${project_slug} $(date +%F)" >/dev/null 2>&1 || true
  # Best-effort: push shouldn't fail the write (e.g. offline).
  git -C "$DEV_LOG_DIR" push -q >/dev/null 2>&1 || true
fi

printf '%s\n' "$target"
