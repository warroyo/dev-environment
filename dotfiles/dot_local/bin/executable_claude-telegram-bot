#!/usr/bin/env bash
# A Telegram bot for driving this server from a phone. Today it starts Claude
# Code and Codex sessions; it is meant to grow other things.
#
# The bot does no conversation: it opens a herdr workspace running an agent in
# a directory under ~/workspace and replies with the name. The actual
# conversation happens in that agent's phone app — which is the point, because
# that gives the full session (tools, permissions prompts, output) instead of a
# chat-shaped imitation of it.
#
# The two families reach their app differently, and it shows in the replies:
# Claude Code turns Remote Control on PER SESSION and prints a claude.ai link
# the bot can hand straight to the phone, while Codex has one app-server daemon
# per machine that every session attaches to, paired once with
# `codex remote-control pair`. So /cc_open can reply with a tappable URL and
# /cx_open can only name the session to pick from the app's list.
#
# Everything it starts lands in the same herdr server as claude-main, so a
# `claude-attach` from a laptop shows every phone-started conversation in the
# sidebar with its live state. Under tmux these were sibling detached sessions
# you could only visit one at a time.
#
# Commands are NAMESPACED BY FAMILY — /cc_ls, /cc_open, and so on — so a later
# family (say /vpn_up, /host_df) can be added without renaming anything or
# colliding here. Only /help and /start are global. Telegram allows a-z, 0-9
# and underscore in command names, hence `cc_` rather than `cc:` or `cc-`.
#
# Commands: /cc_ls  /cc_open <dir>  /cc_sessions  /cc_kill <dir>
#           /cx_ls  /cx_open <dir>  /cx_sessions  /cx_kill <dir>  /help
#
# Configuration comes from ~/.secrets/telegram-bot (sourced by 55_secrets.sh
# for interactive shells; read directly here, because this runs under systemd
# with no shell):
#
#   export TELEGRAM_BOT_TOKEN=123456:ABC...
#   export TELEGRAM_ALLOWED_CHAT_IDS="123456789"     # space or comma separated
#
# The allow-list is the whole security model. A bot token is a bearer
# credential that anyone who learns it can message, and Telegram has no other
# notion of "my bot is private" — so every update from a chat id that is not
# listed is dropped silently (no reply, so a stranger cannot even confirm the
# bot is live). Get your own id by messaging the bot once and reading the
# journal: journalctl -u claude-telegram-bot -f
set -euo pipefail

SECRETS="${TELEGRAM_SECRETS_FILE:-$HOME/.secrets/telegram-bot}"
# shellcheck source=/dev/null
[ -r "$SECRETS" ] && . "$SECRETS"

: "${TELEGRAM_BOT_TOKEN:?set TELEGRAM_BOT_TOKEN in ~/.secrets/telegram-bot}"
: "${TELEGRAM_ALLOWED_CHAT_IDS:?set TELEGRAM_ALLOWED_CHAT_IDS in ~/.secrets/telegram-bot}"

API="https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}"
WORKSPACE="${CLAUDE_WORKSPACE:-$HOME/workspace}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/claude-telegram-bot"
OFFSET_FILE="${STATE_DIR}/offset"
POLL_TIMEOUT=60          # Telegram long-poll: it holds the request open this long

mkdir -p "$STATE_DIR"
for c in curl jq herdr claude-open codex-open; do
  command -v "$c" >/dev/null 2>&1 || { printf 'claude-telegram-bot: %s is required\n' "$c" >&2; exit 1; }
done

log() { printf '%s claude-telegram-bot: %s\n' "$(date -Is)" "$1"; }

# ---------------------------------------------------------------------------
api() {                                   # api <method> [curl args...]
  local method="$1"; shift
  curl -sS --max-time $((POLL_TIMEOUT + 15)) -G "${API}/${method}" "$@"
}

send() {                                  # send <chat_id> <text>
  # No parse_mode on purpose: Markdown/HTML modes reject unbalanced characters
  # in ordinary output (a lone `_` in a directory name, a `<` in an error) and
  # the whole message is silently lost. Plain text always sends.
  api sendMessage --data-urlencode "chat_id=$1" --data-urlencode "text=$2" >/dev/null || \
    log "sendMessage failed for chat $1"
}

authorized() {                            # authorized <chat_id>
  local id
  for id in ${TELEGRAM_ALLOWED_CHAT_IDS//,/ }; do
    [ "$id" = "$1" ] && return 0
  done
  return 1
}

# One "<label>\t<directory>\t<state>\t<workspace id>" line per running Claude
# session. The directory is carried alongside the label because every handler
# below wants to talk about directories, and the workspace id because that is
# what /cc_kill has to close.
#
# Under tmux this listed sessions and the name could not be turned back into a
# path, because claude-open's mapping was lossy. herdr labels ARE the path, so
# the two agree by construction — but the directory is still what gets matched
# on, since that is the thing the user typed.
#
# claude-main is filtered out deliberately: it is not the bot's to list or kill,
# and it is the one workspace whose label is not a path under ~/workspace.
#
# <state> is new and has no tmux equivalent: idle, working, blocked or done for
# the agent in that workspace. A pane with no live agent reports "-".
running_sessions() {
  python3 - <<'PYEOF' || true
import json, subprocess


def herdr(*args):
    try:
        out = subprocess.run(("herdr",) + args, capture_output=True, text=True)
        return json.loads(out.stdout).get("result", {})
    except (OSError, ValueError):
        return {}


cwd = {p["workspace_id"]: p.get("cwd", "")
       for p in herdr("pane", "list").get("panes", [])}
state = {a["workspace_id"]: a.get("agent_status", "-")
         for a in herdr("agent", "list").get("agents", [])}

for w in herdr("workspace", "list").get("workspaces", []):
    label, wid = w.get("label", ""), w["workspace_id"]
    if not label or label == "claude-main":
        continue
    print("\t".join((label, cwd.get(wid, ""), state.get(wid, "-"), wid)))
PYEOF
}

workspace_real() { cd "$WORKSPACE" && pwd -P; }

# ---------------------------------------------------------------------------
# The agent families: /cc_* is Claude Code, /cx_* is Codex. Each handler prints
# its reply on stdout; the dispatcher sends whatever comes back.
#
# The two families do the same four things, so the work lives in one
# family_-prefixed implementation each and the cc_/cx_ handlers are one-line
# wrappers. That is not tidiness for its own sake: the listing logic below
# grew a bug once already (deriving session names instead of asking the opener
# for them), and a second hand-copied version of it is how that happens again.
#
# What a family IS, concretely: an opener script that owns the path → session
# mapping, and a label convention that says which workspaces are its own.
family_opener() {                         # family_opener cc|cx
  case "$1" in
    cc) printf 'claude-open' ;;
    cx) printf 'codex-open' ;;
  esac
}

# running_sessions rows belonging to ONE family. Codex workspaces are labelled
# "codex:<dir>" by codex-open, Claude Code ones are the bare directory — so the
# prefix is the whole test. Without this split /cc_ls would report a directory
# as running when only its Codex session was up, and /cc_kill would then close
# it.
family_rows() {                           # family_rows cc|cx
  running_sessions | awk -F'\t' -v want="$1" '
    {
      is_codex = (index($1, "codex:") == 1)
      if ((want == "cx") != is_codex) next
      print
    }'
}

family_ls() {                             # family_ls cc|cx
  local fam="$1" out="" d path sessions ws s st wid
  ws="$(workspace_real)"
  sessions="$(family_rows "$fam")"
  for d in "$WORKSPACE"/*/; do
    [ -d "$d" ] || continue               # no match: the glob stays literal
    path="$(cd "$d" && pwd -P)"
    # Matched on the session's working directory rather than on its name.
    # Under tmux that mattered because deriving the name here meant a second
    # copy of claude-open's slug rules, and the copy that used to live here got
    # the dotted-directory case wrong. herdr labels are the path itself, so the
    # two can no longer disagree — but the directory is still what the user
    # typed, so it stays the thing that gets matched.
    #
    # The state replaces a bare [running]: herdr knows whether the agent is
    # idle, working, blocked or done, which is the question you actually have
    # when checking on something from a phone.
    st="$(printf '%s\n' "$sessions" | awk -F'\t' -v p="$path" '$2 == p { print $3; exit }')"
    if [ -n "$st" ]; then
      out+="• $(basename "$d")  [${st}]"$'\n'
    else
      out+="• $(basename "$d")"$'\n'
    fi
  done
  # The loop lists one level only, so a session opened on a nested path (a/b)
  # appears nowhere above. Listing those separately keeps the listing honest
  # about what is running.
  while IFS=$'\t' read -r s path st wid; do
    [ -n "$s" ] || continue
    case "$path" in
      "$ws"/*/*) out+="• ${path#"$ws"/}  [${st}]"$'\n' ;;
    esac
  done <<<"$sessions"
  [ -n "$out" ] || out="(no directories in ${WORKSPACE})"
  printf '%s' "$out"
}

family_open() {                           # family_open cc|cx <dir>
  local fam="$1" dir="$2" out rc opener
  opener="$(family_opener "$fam")"
  [ -n "$dir" ] || { printf 'usage: /%s_open <dir>' "$fam"; return; }
  # stderr is folded in: the openers report "already running" there, and that
  # is exactly the answer worth relaying. codex-open also warns there when the
  # app-server daemon is not remote-controlled, which is the difference between
  # a session the phone can drive and one it cannot see.
  set +e
  out="$("$opener" "$dir" 2>&1)"
  rc=$?
  set -e
  if [ $rc -ne 0 ]; then
    printf 'failed to open %s:\n%s' "$dir" "$out"
    return
  fi
  local session url verb
  session="$(printf '%s' "$out" | head -n1)"
  if printf '%s' "$out" | grep -q 'already running'; then
    verb="Already running: ${session}"
  else
    verb="Started ${session} in ${WORKSPACE}/${dir}"
  fi

  case "$fam" in
    cc)
      # claude-open scrapes this out of the Remote Control banner. It may be
      # absent (slow start, banner changed), so the reply has to work without
      # it.
      url="$(printf '%s' "$out" | grep -oE 'https://claude\.ai/code/session_[A-Za-z0-9_-]+' | head -n1)"
      if [ -n "$url" ]; then
        printf '%s\n\n%s' "$verb" "$url"
      else
        printf '%s\n\nOpen the Claude app → Remote Control and pick "%s".' "$verb" "${session#cc-}"
      fi
      ;;
    cx)
      # No per-session link exists to scrape: Codex pairs a whole machine, not
      # a session. The one thing worth relaying instead is whether that pairing
      # is live, because without it the session runs fine on the server and is
      # invisible from the phone — a failure with no symptom in the app.
      if printf '%s' "$out" | grep -q 'not remote-controlled'; then
        printf '%s\n\nWARNING: this server is not paired with the ChatGPT app, so the session is local only.\nOn the server: codex remote-control start && codex remote-control pair' "$verb"
      else
        printf '%s\n\nOpen the ChatGPT app → Codex and pick "%s".\nIt only appears once the session has a first message — send one if the list looks empty.' "$verb" "${session#codex:}"
      fi
      ;;
  esac
}

family_sessions() {                       # family_sessions cc|cx
  local fam="$1" s path st wid out="" ws
  ws="$(workspace_real)"
  while IFS=$'\t' read -r s path st wid; do
    [ -n "$s" ] || continue
    # Directory plus agent state. The label and the directory are the same
    # string now (bar the family prefix), so printing both would just be saying
    # it twice; the state is the part that was never available under tmux.
    out+="• ${path#"$ws"/}  [${st}]"$'\n'
  done <<<"$(family_rows "$fam")"
  [ -n "$out" ] || out="(no sessions running)"
  printf '%s' "$out"
}

family_kill() {                           # family_kill cc|cx <dir>
  local fam="$1" arg="$2" session rc wid opener
  opener="$(family_opener "$fam")"
  [ -n "$arg" ] || { printf 'usage: /%s_kill <dir>' "$fam"; return; }
  # The name comes from the opener, which owns the path → session mapping.
  # This used to reimplement it and only flattened `/`, so a directory with a
  # `.` in its name could be opened but never killed. Under herdr the mapping
  # is nearly the identity function, but it is still asked for rather than
  # assumed: the opener also does the path validation, so a hostile argument
  # from Telegram is rejected there instead of reaching herdr.
  #
  # The old cc-* passthrough is gone. The session listings now print
  # directories, and a cc- prefixed name is a tmux-era session that no longer
  # exists.
  set +e
  session="$("$opener" --session-name "$arg" 2>&1)"
  rc=$?
  set -e
  if [ $rc -ne 0 ]; then
    printf 'cannot name a session for %s:\n%s' "$arg" "$session"
    return
  fi

  # Look the workspace up by label and close it by id. claude-main is already
  # filtered out of running_sessions, so this cannot be aimed at the main
  # session even if someone types its name. family_rows narrows it further, so
  # /cc_kill can never close a Codex session or the other way round.
  wid="$(family_rows "$fam" | awk -F'\t' -v l="$session" '$1 == l { print $4; exit }')"
  if [ -z "$wid" ]; then
    printf 'No session %s.' "$session"; return
  fi
  herdr workspace close "$wid" >/dev/null
  # What closing the workspace means differs by family, and saying the wrong one
  # is worse than saying nothing. Claude Code runs IN the pane, so closing it
  # ends the conversation. A Codex session runs in the app-server daemon and the
  # pane only holds a view of it, so this detaches: the thread survives (it is
  # still in the app and in `codex resume`), and a turn already in flight keeps
  # running until it finishes or is stopped from `codex agents`.
  case "$fam" in
    cc) printf 'Killed %s. Its conversation is gone; /cc_open starts a fresh one.' "$session" ;;
    cx) printf 'Closed %s. The session itself lives in the app-server daemon, so this only detaches the pane — the thread is still in the app and in `codex resume`, and a turn already running keeps going. To remove the conversation: codex delete <name>.' "$session" ;;
  esac
}

cc_ls()       { family_ls cc; }
cc_open()     { family_open cc "$1"; }
cc_sessions() { family_sessions cc; }
cc_kill()     { family_kill cc "$1"; }

cx_ls()       { family_ls cx; }
cx_open()     { family_open cx "$1"; }
cx_sessions() { family_sessions cx; }
cx_kill()     { family_kill cx "$1"; }


bot_help() {
  cat <<EOF
$(hostname -s)

Claude Code (cc_):
/cc_ls              directories in ~/workspace
/cc_open <dir>      start Claude Code there with Remote Control on
                    (creates the directory if it does not exist)
/cc_sessions        what is running now, with agent state
/cc_kill <dir>      stop a session

Codex (cx_):
/cx_ls              directories in ~/workspace
/cx_open <dir>      start Codex there, attached to this machine's
                    app-server daemon (creates the directory too)
/cx_sessions        what is running now, with agent state
/cx_kill <dir>      stop a session

Codex sessions appear in the ChatGPT app once this server is paired
(on the server: codex remote-control pair).
EOF
}

handle() {                                # handle <chat_id> <text>
  local chat="$1" text="$2" cmd arg
  cmd="${text%% *}"
  arg="${text#"$cmd"}"; arg="${arg# }"
  # Telegram appends @botname to commands in groups, and to tapped commands in
  # some clients — strip it or every command misses.
  cmd="${cmd%%@*}"
  case "$cmd" in
    # --- Claude Code family. New families go alongside, not inside: keep the
    #     prefix in the command name so nothing here has to be renamed later.
    /cc_open)     send "$chat" "$(cc_open "$arg")" ;;
    /cc_ls)       send "$chat" "$(cc_ls)" ;;
    /cc_sessions) send "$chat" "$(cc_sessions)" ;;
    /cc_kill)     send "$chat" "$(cc_kill "$arg")" ;;
    # --- Codex family.
    /cx_open)     send "$chat" "$(cx_open "$arg")" ;;
    /cx_ls)       send "$chat" "$(cx_ls)" ;;
    /cx_sessions) send "$chat" "$(cx_sessions)" ;;
    /cx_kill)     send "$chat" "$(cx_kill "$arg")" ;;
    # --- global
    /start|/help) send "$chat" "$(bot_help)" ;;
    *)            send "$chat" "Unknown command."$'\n\n'"$(bot_help)" ;;
  esac
}

# ---------------------------------------------------------------------------
# Offset: Telegram redelivers every update until it is acknowledged by asking
# for a higher offset, so this file is what stops already-handled commands from
# running twice. On a first run (or after the state was lost) the backlog is
# skipped rather than replayed: a `/open` sent hours ago should not fire when
# the server comes back from a reboot.
if [ -r "$OFFSET_FILE" ]; then
  OFFSET="$(cat "$OFFSET_FILE")"
else
  # offset=-1 with no wait returns only the most recent pending update.
  OFFSET="$(api getUpdates --data-urlencode "offset=-1" --data-urlencode "timeout=0" \
            | jq -r '(.result[-1].update_id // 0) + 1')"
  printf '%s\n' "$OFFSET" >"$OFFSET_FILE"
  log "skipping backlog, starting at offset ${OFFSET}"
fi

log "polling as $(api getMe | jq -r '.result.username // "unknown"')"

while :; do
  if ! RESP="$(api getUpdates --data-urlencode "offset=${OFFSET}" \
                              --data-urlencode "timeout=${POLL_TIMEOUT}" 2>&1)"; then
    log "getUpdates failed: ${RESP}"
    sleep 5
    continue
  fi
  if [ "$(jq -r '.ok // false' <<<"$RESP" 2>/dev/null)" != "true" ]; then
    # 409 here means a second copy of the bot is polling the same token
    # (Telegram allows exactly one). Backing off rather than exiting keeps
    # whichever instance survives a redeploy working.
    log "telegram error: $(jq -rc '.description // .' <<<"$RESP" 2>/dev/null || printf '%s' "$RESP")"
    sleep 10
    continue
  fi

  while read -r update; do
    [ -n "$update" ] || continue
    id="$(jq -r '.update_id' <<<"$update")"
    OFFSET=$((id + 1))
    printf '%s\n' "$OFFSET" >"$OFFSET_FILE"   # ack first: a command that crashes
                                              # the handler must not loop forever
    chat="$(jq -r '.message.chat.id // empty' <<<"$update")"
    text="$(jq -r '.message.text // empty' <<<"$update")"
    [ -n "$chat" ] && [ -n "$text" ] || continue
    if ! authorized "$chat"; then
      log "ignored message from unauthorized chat ${chat}: ${text:0:40}"
      continue
    fi
    log "chat ${chat}: ${text}"
    handle "$chat" "$text" || log "handler failed for: ${text}"
  done <<<"$(jq -c '.result[]' <<<"$RESP")"
done
