#!/usr/bin/env bash
# Writes ssh aliases for every lab target on the tailnet, so agents and humans
# both type `ssh evo-x2 '...'` rather than remembering users and addresses.
#
# The host list comes from the tailnet itself — every peer tagged tag:lab (see
# policy/tailnet.hujson) — so no hostname is ever committed to this repo. Re-run
# after a target joins or leaves; it rewrites the file from scratch.
#
# For each target <name> it writes two aliases:
#   <name>        User agent   routine work, accepted without a prompt
#   <name>-admin  User <you>   needs a Tailscale browser check (the approval)
#
# Host keys are collected with ssh-keyscan over the tailnet into a separate
# known_hosts file. The tailnet connection is already authenticated by the
# peer's WireGuard key, so this is not blind trust-on-first-use, and nothing
# here ever sets StrictHostKeyChecking=no.
#
# Output: ~/.ssh/config.d/lab and ~/.ssh/known_hosts.d/lab, picked up by the
# Include in ~/.ssh/config.
set -euo pipefail

TAG="${LAB_TAG:-tag:lab}"
AGENT_USER="${LAB_AGENT_USER:-agent}"
ADMIN_USER="${LAB_ADMIN_USER:-$USER}"
CONF="$HOME/.ssh/config.d/lab"
KNOWN="$HOME/.ssh/known_hosts.d/lab"

for c in tailscale jq ssh-keyscan; do
  command -v "$c" >/dev/null 2>&1 || { echo "lab-ssh-config: $c not found" >&2; exit 1; }
done

status="$(tailscale status --json)" || {
  echo "lab-ssh-config: tailscale is not running or not logged in" >&2
  exit 1
}

# name <TAB> MagicDNS name <TAB> tailnet IPv4, for every peer carrying $TAG.
targets="$(jq -r --arg tag "$TAG" '
  .Peer[]
  | select((.Tags // []) | index($tag))
  | [(.DNSName | split(".")[0]), (.DNSName | rtrimstr(".")), .TailscaleIPs[0]]
  | @tsv' <<<"$status")"

mkdir -p "${CONF%/*}" "${KNOWN%/*}"
chmod 700 "${CONF%/*}" "${KNOWN%/*}"

tmp_conf="$(mktemp)"
tmp_known="$(mktemp)"
trap 'rm -f "$tmp_conf" "$tmp_known"' EXIT

{
  echo "# Generated by lab-ssh-config from tailnet peers tagged ${TAG}."
  echo "# Do not edit; re-run lab-ssh-config instead."
} >"$tmp_conf"

count=0
while IFS=$'\t' read -r name fqdn ip; do
  [ -n "$name" ] || continue
  cat >>"$tmp_conf" <<EOF

Host ${name}
  HostName ${fqdn}
  User ${AGENT_USER}
  UserKnownHostsFile ${KNOWN}

Host ${name}-admin
  HostName ${fqdn}
  User ${ADMIN_USER}
  UserKnownHostsFile ${KNOWN}
EOF
  # Record the key under the name ssh will look it up by (HostName), not the
  # IP that was scanned.
  if keys="$(ssh-keyscan -T 5 -t ed25519 "$ip" 2>/dev/null)" && [ -n "$keys" ]; then
    sed "s/^${ip//./\\.} /${fqdn} /" <<<"$keys" >>"$tmp_known"
  else
    echo "  ${name}: no host key (offline?); ssh will ask on first connect" >&2
  fi
  printf '  %-20s %s\n' "$name" "$fqdn"
  count=$((count + 1))
done <<<"$targets"

install -m 600 "$tmp_conf" "$CONF"
install -m 600 "$tmp_known" "$KNOWN"
echo "lab-ssh-config: ${count} target(s) tagged ${TAG} written to ${CONF}"
