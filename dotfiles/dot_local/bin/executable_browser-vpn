#!/usr/bin/env bash
# Open/close a local SOCKS5 proxy (ssh -D) to claude-server, so a browser on
# THIS machine can reach whatever's routed on the server — including the
# second OpenVPN environment (client-vpn) — without opening a second VPN
# connection from here. See docs/client-work-setup.md.
set -euo pipefail

HOST="${CLAUDE_SERVER_HOST:-claude-server}"
PORT="${BROWSER_VPN_PORT:-1080}"
CTRL="${TMPDIR:-/tmp}/browser-vpn-${PORT}.sock"

usage() { printf 'usage: %s {up|down|status}\n' "${0##*/}" >&2; exit 2; }
[ $# -eq 1 ] || usage

case "$1" in
  up)
    if ssh -S "$CTRL" -O check "$HOST" 2>/dev/null; then
      printf 'browser VPN proxy already up on 127.0.0.1:%s\n' "$PORT"
      exit 0
    fi
    ssh -f -N -M -S "$CTRL" -D "127.0.0.1:${PORT}" "$HOST"
    printf 'browser VPN proxy up on socks5://127.0.0.1:%s\n' "$PORT"
    printf 'point FoxyProxy at it (enable "Proxy DNS via SOCKS5")\n'
    ;;
  down)
    if ssh -S "$CTRL" -O exit "$HOST" 2>/dev/null; then
      printf 'browser VPN proxy down\n'
    else
      printf 'not running\n'
    fi
    ;;
  status)
    if ssh -S "$CTRL" -O check "$HOST" 2>/dev/null; then
      printf 'up: socks5://127.0.0.1:%s via %s\n' "$PORT" "$HOST"
    else
      printf 'down\n'
    fi
    ;;
  *)
    usage
    ;;
esac
