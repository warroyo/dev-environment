#!/usr/bin/env bash
# Attach to the session dedicated to the second, unrelated OpenVPN environment.
# Kept separate from claude-main so that work never mixes into the main session.
#
#   claude-env          # herdr client HERE, bridged to the server over ssh
#   claude-env --mosh   # herdr client on the SERVER, over mosh
#
# Separation is a NAMED HERDR SESSION (`--session claude-env`), not a workspace
# inside claude-main. A named session gets its own server and its own socket, so
# nothing from this environment shows up in claude-main's sidebar — which is the
# whole point of keeping it apart. A workspace would have been visible there.
#
# Claude Code here runs directly on the server, not inside a container: the
# tunnel this environment needs is a split one that never takes over the host's
# default route, so there is nothing to isolate it from (see
# provision/server-bootstrap.sh). That also means this session gets the real
# home directory, ssh keys, gitconfig and editor.
#
# The tunnel is deliberately not brought up here. That environment's identity
# is a certificate shared with other machines and only one connection can be
# live at a time, so connecting is always an explicit act — this only warns
# when it's down.
#
# KNOWN GAP: this used to take an optional starting directory, which worked
# because tmux's `new-session -A -c <dir>` sets it at creation time. herdr has
# no equivalent on `--session` attach: a workspace can be pointed at a cwd, but
# only over the session's own API socket, which does not exist until the
# session has been attached at least once. So: attach, then open a workspace
# where you want it (prefix + shift-N) or just cd.
set -euo pipefail

HOST="${CLAUDE_SERVER_HOST:-claude-server}"
SESSION="claude-env"
MODE=local

usage() {
  cat <<'EOF'
usage: claude-env [--mosh]

  (default)   run the herdr client locally, bridged to the server over ssh
  --mosh      run the herdr client on the server, over mosh
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    --mosh)    MODE=mosh; shift ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'claude-env: unknown option %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done

if [ -n "${TMUX:-}" ]; then
  printf 'claude-env: refusing to run inside tmux — detach first (Ctrl-b d).\n' >&2
  exit 1
fi
if [ "${HERDR_ENV:-}" = 1 ]; then
  printf 'claude-env: already inside a herdr pane.\n' >&2
  exit 1
fi

# Warn rather than connect: bringing the tunnel up implicitly could kick
# another machine off the shared identity. Done as its own ssh call because
# `herdr --remote` owns its connection and has nowhere to hang a pre-command;
# ControlMaster makes the second connection cheap anyway.
if ! ssh -o BatchMode=yes "$HOST" 'ip link show tun0 >/dev/null 2>&1'; then
  printf '\n  client VPN is down — run: client-vpn up\n\n' >&2
fi

if [ "$MODE" = mosh ]; then
  command -v mosh >/dev/null 2>&1 || {
    printf 'claude-env: mosh is not installed locally.\n' >&2; exit 1; }
  exec mosh "$HOST" -- sh -lc "tput reset; exec herdr --session '${SESSION}'"
fi

command -v herdr >/dev/null 2>&1 || {
  printf 'claude-env: herdr is not installed locally.\n' >&2
  printf '  run provision/client-personal-bootstrap.sh, or use --mosh.\n' >&2
  exit 1; }
exec herdr --remote "$HOST" --session "$SESSION"
