[user]
    name = Will Arroyo
    email = willarroyoa@gmail.com

[init]
    defaultBranch = main

[core]
    editor = vim
    autocrlf = input

[pull]
    rebase = false

[push]
    autoSetupRemote = true

[color]
    ui = auto

[alias]
    st = status -sb
    co = checkout
    br = branch
    ci = commit
    lg = log --graph --oneline --decorate --all
    last = log -1 HEAD
