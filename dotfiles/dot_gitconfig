# Shared git config. NO [user] section lives here on purpose: identity is the
# one thing that is both machine-specific and identifying, so it stays out of
# the repo entirely and comes from the includes at the bottom of this file.

[init]
    defaultBranch = main

[core]
    editor = vim
    autocrlf = input
    excludesfile = ~/.gitignore

[pull]
    rebase = false

[push]
    autoSetupRemote = true

[color]
    ui = auto

[alias]
    st = status -sb
    co = checkout
    br = branch
    ci = commit
    lg = log --graph --oneline --decorate --all
    last = log -1 HEAD
    amend = commit --amend --no-edit

# Identity, kept out of git. Created by provision/*-bootstrap.sh, which
# migrates any identity already configured on the machine:
#
#   [user]
#       name = your-name
#       email = your-email
#
# Using a dedicated alias here (rather than your primary address) keeps your
# real mailbox out of every public commit while staying attributable.
[include]
    path = ~/.gitconfig.local

# Platform-specific bits — currently just the credential helper, which differs
# between macOS (keychain) and Linux. Written by chezmoi from
# dot_gitconfig.platform.tmpl. Included last so it wins.
[include]
    path = ~/.gitconfig.platform
