{{ if eq .role "server" -}}
#!/bin/bash
# chezmoi run_after script: makes every Claude Code skill a Codex skill too.
#
# Codex loads skills from ~/.codex/skills and ~/.agents/skills. It never looks
# in ~/.claude/skills, which is where all of ours are: some written there by
# chezmoi (dot_claude/skills), some linked there by the bootstrap (the vault's
# log-session and second-brain, will-prose). The SKILL.md format is the same,
# so each one only needs a symlink:
#
#   ~/.codex/skills/<name> -> ~/.claude/skills/<name>
#
# Linking to the ~/.claude/skills entry rather than to its final target keeps a
# single source of truth. When link_skill re-points a skill, Codex follows.
#
# run_after, not run_onchange: the set of skills changes whenever the bootstrap
# links a new one, and chezmoi cannot hash that. Every step is a no-op once the
# link is right, so running on every apply costs nothing.
#
# Server only, like the rest of the Codex tooling: it is the one machine with
# Codex installed.
set -euo pipefail

claude_skills="{{ .chezmoi.homeDir }}/.claude/skills"
codex_skills="{{ .chezmoi.homeDir }}/.codex/skills"
agents_skills="{{ .chezmoi.homeDir }}/.agents/skills"

[ -d "$claude_skills" ] || exit 0
mkdir -p "$codex_skills"

for src in "$claude_skills"/*; do
  name="$(basename "$src")"
  link="$codex_skills/$name"

  # Not a skill: `synced` holds claude.ai's synced skills, keyed by id.
  [ -f "$src/SKILL.md" ] || continue
  # Codex already loads ~/.agents/skills (adhd lives there), and a second copy
  # under ~/.codex/skills would list the skill twice.
  [ -e "$agents_skills/$name" ] && continue

  if [ -L "$link" ]; then
    [ "$(readlink "$link")" = "$src" ] && continue
    ln -sfn "$src" "$link"
  elif [ -e "$link" ]; then
    echo "link-codex-skills: $link exists and is not a symlink — leaving it alone" >&2
  else
    ln -s "$src" "$link"
  fi
done

# Drop links this script made whose skill has since gone from ~/.claude/skills.
# Only links into $claude_skills are touched, never anything Codex put there.
for link in "$codex_skills"/*; do
  [ -L "$link" ] || continue
  case "$(readlink "$link")" in
    "$claude_skills"/*) [ -e "$link" ] || rm -f "$link" ;;
  esac
done
{{ end -}}
