[[ -o interactive ]] || return

# Shortcuts for reaching the Claude Code session ON THE SERVER. Both targets
# are SSH clients — they execute nothing locally — so they ship on every
# machine, including the restricted ones that must never have the CLI
# installed. See the header of .chezmoiignore.tmpl for where that line is drawn.
#
# Which host they SSH to comes from $CLAUDE_SERVER_HOST, default `claude-server`.
# That Host block is only in the managed ~/.ssh/config on the mesh-VPN roles;
# on the work laptop, define it yourself in ~/.ssh/config.local (unmanaged) or
# set CLAUDE_SERVER_HOST in ~/.zsh.local. See docs/client-work-setup.md.

alias ca='claude-attach'
alias ce='claude-env'

{{ if eq .role "server" -}}
# Claude Code deliberately downgrades colour output whenever $TMUX is set, as a
# conservative default for unknown terminals. Ghostty is the standardized
# terminal for this setup and is known-good for true colour, so opt back in.
export CLAUDE_CODE_TMUX_TRUECOLOR=1
{{- end }}
