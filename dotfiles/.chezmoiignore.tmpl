{{/*
  IMPORTANT: chezmoi matches these patterns against the *target* path
  (relative to $HOME), NOT the source path. So the entry for
  dot_local/bin/executable_claude-session must be written as
  .local/bin/claude-session — source-path spellings silently match nothing,
  which would quietly ship the excluded scripts everywhere.
  Verify with: chezmoi ignored

  Keyed on .role (set per machine in ~/.config/chezmoi/chezmoi.toml by the
  bootstrap scripts), defaulting to "restricted" in .chezmoidata.yaml.
*/}}

{{/*
  What "no Claude Code on the work laptop" actually means: the CLI is never
  INSTALLED there, and nothing on that machine ever executes it. It does NOT
  mean the machine can't reach the session running on the server.

  So the line this file draws is "does the file run claude locally?", not
  "does the file have claude in its name":

    claude-attach / claude-env   pure SSH clients. They run `ssh` locally and
                                 `claude` on the SERVER. Ship everywhere — this
                                 is how a restricted client reaches the session.
    70_claude.sh                 the ca/ce aliases for the above. Same.
    claude-session               runs `claude` in the current shell. Server only
                                 (it is what claude-tmux.service execs).

  Enforcement of the never-install rule lives where an install would actually
  happen: no CLI install step in client-work-bootstrap.sh (which verifies the
  absence afterwards), autoInstallIdeExtension:false in the managed VS Code
  settings, and 70_work_guard.sh below.
*/}}
{{- $claudeInstalled := eq .role "server" }}

{{- if not $claudeInstalled }}
{{/*
  Runs claude in-process, so it only belongs where the CLI exists.
*/}}
.local/bin/claude-session
{{/*
  Dev session log: the shared writer, the /log-session command, and the
  CLAUDE.md priming note all only make sense where Claude Code itself runs.
*/}}
.local/bin/dev-log-entry
.claude/commands/log-session.md
.claude/CLAUDE.md
{{- end }}

{{- if or (eq .role "server") (eq .role "personal") }}
{{/* The VS Code auto-install guard is pointless on the machines that are
     allowed to have Claude Code; it exists for the restricted clients. */}}
.config/shell/source/70_work_guard.sh
{{- end }}

{{- if ne .role "personal" }}
{{/*
  paste-image is macOS-only (it shells out to osascript to read the clipboard)
  and exists to push an image to the server, so it only makes sense on the
  personal Air. Excluding it elsewhere keeps a broken script off the server.
*/}}
.local/bin/paste-image
{{- end }}

{{- if ne .role "server" }}
{{/* Headless-server-only: remap $BROWSER to print URLs rather than launch one. */}}
.config/shell/source/60_browser.sh
{{- end }}

{{- if ne .chezmoi.os "linux" }}
{{/*
  macOS gets its ssh-agent from launchd, and AddKeysToAgent/UseKeychain in
  ~/.ssh/config handle key loading there, so none of this is needed.
*/}}
.config/shell/source/60_ssh_agent.sh
{{- end }}
