#!/usr/bin/env python3
"""Copy the running model engines' Prometheus metrics into node_exporter's
textfile directory, each sample labelled with the llama-swap model name.

    llama-engine-metrics <llama-swap url> <output .prom file>

Why not scrape the engines directly: each one listens on 127.0.0.1 on a port
llama-swap picks when it starts the model, so nothing off the box can reach
it. And not llama-swap's /upstream/<model>/metrics passthrough: asking for a
model that is not loaded makes llama-swap load it, so a scrape could swap out
the working model. This asks /running first and reads only models that are
already up.

Run by llama-engine-metrics.timer (role inference_host). A failed read leaves
llama_engine_up 0 for that model rather than stale counters.
"""
import json
import os
import re
import sys
import tempfile
import urllib.request

SAMPLE = re.compile(r"^([a-zA-Z_:][a-zA-Z0-9_:]*)(?:\{(.*)\})?\s+(\S+)(?:\s+\S+)?$")


def get(url):
    with urllib.request.urlopen(url, timeout=5) as r:
        return r.read().decode()


def label_value(v):
    return v.replace("\\", "\\\\").replace("\n", "\\n").replace('"', '\\"')


def parse(text, model, families, order):
    """Add every sample in text to families, with model="<model>" prepended.
    Samples follow the # HELP / # TYPE of their family (name, name_total,
    name_bucket, ...), so a sample joins the family declared last."""
    current = None
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        if line.startswith("#"):
            parts = line.split(None, 3)
            if len(parts) >= 3 and parts[1] in ("HELP", "TYPE"):
                name = parts[2]
                fam = families.setdefault(name, {"help": None, "type": None, "samples": []})
                if name not in order:
                    order.append(name)
                fam[parts[1].lower()] = parts[3] if len(parts) > 3 else ""
                current = name
            continue
        m = SAMPLE.match(line)
        if not m:
            continue
        name, labels, value = m.groups()
        # Timestamps are dropped: the textfile collector rejects them.
        labels = f'model="{label_value(model)}"' + (f",{labels}" if labels else "")
        fam_name = current if current and name.startswith(current) else name
        fam = families.setdefault(fam_name, {"help": None, "type": None, "samples": []})
        if fam_name not in order:
            order.append(fam_name)
        fam["samples"].append(f"{name}{{{labels}}} {value}")


def main():
    if len(sys.argv) != 3:
        sys.exit(__doc__.strip().splitlines()[3].strip())
    swap, out = sys.argv[1].rstrip("/"), sys.argv[2]

    families, order, up = {}, [], []
    try:
        running = json.loads(get(f"{swap}/running")).get("running") or []
        swap_ok = 1
    except Exception as e:  # noqa: BLE001 - any failure means "unreachable"
        print(f"llama-engine-metrics: {swap}/running: {e}", file=sys.stderr)
        running, swap_ok = [], 0

    for m in running:
        model, state, proxy = m.get("model", ""), m.get("state", ""), m.get("proxy")
        ok = 0
        if state == "ready" and proxy:
            try:
                parse(get(f"{proxy}/metrics"), model, families, order)
                ok = 1
            except Exception as e:  # noqa: BLE001
                print(f"llama-engine-metrics: {model}: {e}", file=sys.stderr)
        up.append((model, state, ok))

    lines = [
        "# HELP llama_swap_reachable Whether llama-swap answered /running.",
        "# TYPE llama_swap_reachable gauge",
        f"llama_swap_reachable {swap_ok}",
        "# HELP llama_engine_up Whether a loaded model's engine answered /metrics.",
        "# TYPE llama_engine_up gauge",
    ]
    lines += [f'llama_engine_up{{model="{label_value(m)}",state="{label_value(s)}"}} {ok}'
              for m, s, ok in up]
    for name in order:
        fam = families[name]
        if not fam["samples"]:
            continue
        if fam["help"] is not None:
            lines.append(f"# HELP {name} {fam['help']}")
        if fam["type"] is not None:
            lines.append(f"# TYPE {name} {fam['type']}")
        lines += fam["samples"]

    # Atomic: node_exporter must never read a half-written file.
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(out), prefix=".llama-engines.")
    with os.fdopen(fd, "w") as f:
        f.write("\n".join(lines) + "\n")
    os.chmod(tmp, 0o644)
    os.replace(tmp, out)
    return 0 if swap_ok else 1


if __name__ == "__main__":
    sys.exit(main())
