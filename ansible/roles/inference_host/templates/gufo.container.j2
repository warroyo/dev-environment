# Managed by dev-environment ansible (role inference_host). Do not edit here.
# Rootful podman quadlet; systemd generates gufo.service from this file.
[Unit]
Description=Gufo OpenAI-compatible LLM server
# The port binds to the tailnet address, which exists only once tailscaled is up.
Wants=network-online.target
After=network-online.target tailscaled.service

[Container]
Image={{ gufo_image }}
AddDevice=/dev/kfd
AddDevice=/dev/dri
# Flash-Next pins its host buffers; the default memlock limit fails them.
Ulimit=memlock=-1:-1
PublishPort={{ gufo_tailnet_ip.stdout | trim }}:{{ gufo_port }}:8080
Volume={{ inference_models_dir }}:/models:ro
Exec=gufo serve --host 0.0.0.0 --port 8080 llm --model /models/{{ gufo_model }} {{ gufo_args | join(' ') }}

[Service]
# Loading ~100 GiB of weights takes a while.
TimeoutStartSec=900
Restart=on-failure
RestartSec=30

{% if gufo_enabled | bool %}
[Install]
# Quadlets are enabled by this section, not by systemctl enable.
WantedBy=multi-user.target
{% else %}
# gufo_enabled is false: no [Install] section, so it does not start at boot.
{% endif %}
