# Client lab network details, for the routing and split-DNS steps in
# server-bootstrap.sh, verify-server.sh and the macOS client bootstraps.
#
# Copy to ~/.config/client-lab.env, fill in the real values, chmod 600. Never
# commit the real file: this repo is public. Without it, those steps are
# skipped. See provision/lib/client-lab.sh.

# DNS zone the lab's names live in. Clients send only this zone to the server.
LAB_ZONE=corp.example

# The one prefix forwarded from the LAN and the tailnet into the tunnel.
LAB_SUBNET=10.20.0.0/16

# The lab's own resolver, reached only by the server, through the tunnel.
LAB_DNS=10.20.0.53

# Used by verify-server.sh: a name in LAB_ZONE and an address in LAB_SUBNET
# that should always answer while the tunnel is up.
LAB_PROBE_NAME=vcfa.corp.example
LAB_PROBE_ADDR=10.20.0.10
